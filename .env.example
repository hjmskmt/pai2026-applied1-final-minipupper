# cp .env.example .env して値を設定する（.env はgit管理外）
# ロボットとPCで同じ値にする
ROS_DOMAIN_ID=0
# RMWはロボット側と合わせる（公式イメージはデフォルトの Fast DDS）
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ANTHROPIC_API_KEY=
# Gemini 版（pixi run -e agent agent-gemini）。Google AI Studio で無料で作れる
GEMINI_API_KEY=
# 重いデータ（rosbag など）の置き場所。リポジトリの外の、書き込めるディレクトリを指定する
DATA_DIR=/path/to/data/minipupper_ai
